PORT=8787
# Must be a non-trivial high entropy string. Production requires TLS reverse proxy.
SESSION_SECRET=change-this-to-at-least-32-random-characters-before-launch
DATABASE_FILE=./var/designpro.sqlite
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=
CORS_ORIGIN=http://localhost:8787
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Disable payments by default; activate only when gateway, tax and refund flows are approved.
PAYMENTS_ENABLED=false

# Local UAT only. NEVER enable in production; only SUPER_ADMIN can use it.
UAT_DEMO_ENABLED=false
REQUIRE_VERIFIED_EMAIL_FOR_CHECKOUT=false

# Optional zero-API-key local concept assistant. Install Ollama and pull the model first.
AI_PROVIDER=disabled
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
